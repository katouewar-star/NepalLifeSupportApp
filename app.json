{
  "expo": {
    "name": "ネパール生活支援",
    "slug": "nepal-life-support",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roadofkato.nepallifesupport"
    },
    "android": {
      "package": "com.roadofkato.nepallifesupport"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-asset",
      "expo-secure-store",
      "expo-av",
      [
        "expo-image-picker",
        {
          "photosPermission": "写真へのアクセスを許可してください（スキャン翻訳に使用）",
          "cameraPermission": "カメラへのアクセスを許可してください（スキャン翻訳に使用）"
        }
      ]
    ],
    "scheme": "nepal-life-support",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d72243f5-b560-4f1d-83a0-3411379f5654"
      }
    },
    "owner": "ewar"
  }
}
